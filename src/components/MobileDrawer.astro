---
import { waLink } from "../data/site";
---

<div
  id="navDrawer"
  class="hidden fixed inset-x-0 top-[108px] mx-[2.5%] w-[95%] bg-white/95 backdrop-blur-xl border border-white/20 rounded-2xl px-6 pt-6 pb-8 z-[9999] flex-col shadow-[0_8px_32px_0_rgba(27,50,70,0.15)] font-sans"
  role="dialog"
  aria-label="Menú móvil"
>
  <a href="/" class="py-3.5 text-base font-bold text-slate-800 border-b border-slate-200/50">Inicio</a>
  <a href="/servicios" class="py-3.5 text-base font-bold text-slate-800 border-b border-slate-200/50">Servicios</a>
  <a href="/portafolio" class="py-3.5 text-base font-bold text-slate-800 border-b border-slate-200/50">Portafolio</a>
  <a href="/contacto" class="py-3.5 text-base font-bold text-slate-800 border-b border-slate-200/50">Contacto</a>
  <a
    href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
    class="mt-5 inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg bg-orange text-white font-bold text-sm"
    target="_blank" rel="noopener"
  >
    Quiero crecer
  </a>
</div>
