---
import { waLink } from "../data/site";
import { navLinks, esRutaActiva } from "../data/nav";

const pathname = Astro.url.pathname;
---

<div
  id="navDrawer"
  class="hidden fixed inset-x-0 top-[108px] mx-[2.5%] w-[95%] backdrop-blur-2xl border border-white/10 rounded-[28px] px-6 pt-6 pb-8 z-[9999] flex-col shadow-[0_16px_50px_-10px_rgba(0,0,0,0.7)] font-sans"
  style="background: linear-gradient(160deg, rgba(10,22,40,0.92) 0%, rgba(5,13,31,0.88) 100%);"
  role="dialog"
  aria-label="Menú móvil"
>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class="nav-link-movil py-3.5 text-base font-bold text-white/90 hover:text-white transition-colors border-b border-white/10"
      aria-current={esRutaActiva(link.href, pathname) ? "page" : undefined}
    >
      {link.label}
    </a>
  ))}
  <a
    href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
    class="mt-5 inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-orange text-white font-bold text-sm shadow-[0_4px_18px_rgba(245,166,35,0.35)]"
    target="_blank" rel="noopener"
  >
    Quiero crecer
  </a>
</div>
