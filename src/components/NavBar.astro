---
import { Menu, X } from "lucide-astro";
import MobileDrawer from "./MobileDrawer.astro";
import { waLink } from "../data/site";
---

<header
  id="navbar"
  class="fixed left-1/2 -translate-x-1/2 z-[9999] transition-all duration-500 w-[95%] max-w-6xl rounded-2xl border border-white/10 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.6)] backdrop-blur-2xl flex items-center justify-between top-6 py-4 px-6 md:px-8 h-[74px]"
  style="background: linear-gradient(135deg, rgba(10,22,40,0.78) 0%, rgba(5,13,31,0.72) 100%);"
  role="navigation"
  aria-label="Navegación principal"
>
  <!-- glow interior sutil -->
  <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-60" style="background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(30,144,255,0.10), transparent 70%);" aria-hidden="true"></div>

  <!-- logo -->
  <a href="/" class="relative flex items-center gap-2 shrink-0" aria-label="Juancito Ads inicio">
    <img src="/logo.png" alt="Juancito Ads" class="nav-logo h-14 w-auto block object-contain" height="56" />
  </a>

  <!-- links -->
  <ul class="relative hidden md:flex items-center gap-8 font-sans" role="list">
    <li><a href="/" class="text-sm font-semibold text-white/85 hover:text-white transition-colors">Inicio</a></li>
    <li><a href="/servicios" class="text-sm font-semibold text-white/85 hover:text-white transition-colors">Servicios</a></li>
    <li><a href="/cotizador" class="text-sm font-semibold text-orange hover:text-white transition-colors">Cotizador</a></li>
    <li><a href="/portafolio" class="text-sm font-semibold text-white/85 hover:text-white transition-colors">Portafolio</a></li>
    <li><a href="/contacto" class="text-sm font-semibold text-white/85 hover:text-white transition-colors">Contacto</a></li>
  </ul>

  <div class="relative flex items-center gap-3">
    <a
      href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
      class="hidden md:inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-orange text-white font-bold text-sm shadow-[0_4px_18px_rgba(245,166,35,0.35)] hover:bg-orange-dark hover:shadow-glow-orange hover:-translate-y-0.5 hover:scale-[1.03] transition-all"
      style="transition-timing-function: var(--ease-brand);"
      target="_blank" rel="noopener"
    >
      Quiero crecer
    </a>
    <button id="navToggle" class="md:hidden p-2.5 -mr-2.5 bg-transparent border-0" aria-label="Abrir menú" aria-expanded="false">
      <Menu id="navIconOpen" class="w-6 h-6 text-white" />
      <X id="navIconClose" class="hidden w-6 h-6 text-white" />
    </button>
  </div>
</header>

<MobileDrawer />

<script>
  const toggle = document.getElementById("navToggle");
  const drawer = document.getElementById("navDrawer");
  const iconOpen = document.getElementById("navIconOpen");
  const iconClose = document.getElementById("navIconClose");
  let open = false;

  function setOpen(value: boolean) {
    open = value;
    drawer?.classList.toggle("flex", open);
    drawer?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  /**
   * Encoge el navbar al bajar y lo devuelve a su tamaño al volver al tope.
   * La histéresis (40px para encoger, 12px para volver) evita el parpadeo
   * cuando el scroll se queda oscilando justo sobre el umbral.
   */
  const navbar = document.getElementById("navbar");

  function syncShrink() {
    if (!navbar) return;
    const y = window.scrollY;
    const encogido = navbar.classList.contains("is-scrolled");
    if (!encogido && y > 40) navbar.classList.add("is-scrolled");
    else if (encogido && y < 12) navbar.classList.remove("is-scrolled");
  }

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        syncShrink();
      });
    },
    { passive: true }
  );

  // Al recargar a media página el navegador restaura el scroll: hay que evaluar
  // el tamaño de entrada, no esperar al primer movimiento del usuario.
  syncShrink();

  toggle?.addEventListener("click", () => setOpen(!open));
  drawer?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("click", (e) => {
    if (open && drawer && toggle && !drawer.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
      setOpen(false);
    }
  });
</script>
