---
import ParticleCanvas from "./ParticleCanvas.astro";
---

<section id="hero" class="relative min-h-svh flex items-center overflow-hidden bg-bg-deep pt-[100px]" aria-label="Bienvenida">
  <ParticleCanvas />

  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[520px] h-[520px] bg-blue-neon/[0.18] -top-[120px] -left-20"
    style="animation: orb-float-1 12s ease-in-out infinite;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[380px] h-[380px] bg-orange/[0.08] -bottom-[60px] right-[5%]"
    style="animation: orb-float-2 15s ease-in-out infinite 2s;"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] w-full max-w-[1160px] mx-auto px-5 sm:px-10 py-16 sm:py-24 text-center">
    <h1 class="reveal text-4xl sm:text-5xl md:text-7xl font-black leading-tight max-w-[20ch] text-balance mb-4 mx-auto">
      Tu negocio puede vender más.
    </h1>
    <p class="reveal reveal-delay-1 text-2xl sm:text-3xl md:text-4xl font-extrabold text-blue-neon leading-snug mb-12 mx-auto" style="text-shadow: 0 0 24px rgba(30,144,255,0.5);">
      Lo hacemos con Meta Ads e IA.
    </p>

    <div class="reveal reveal-delay-2 flex flex-col sm:flex-row justify-center items-center gap-5 max-w-4xl mx-auto">
      <a
        href="/servicios/campanas-ads"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-blue-neon text-white font-bold text-base shadow-[0_4px_18px_rgba(30,144,255,0.35)] hover:bg-blue-dark hover:shadow-glow-blue hover:-translate-y-0.5 transition-all"
      >
        Campañas de Ads
      </a>
      <a
        href="/servicios/campanas-redes"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-orange text-white font-bold text-base shadow-[0_4px_18px_rgba(245,166,35,0.35)] hover:bg-orange-dark hover:shadow-glow-orange hover:-translate-y-0.5 transition-all"
      >
        Campañas + Redes
      </a>
      <a
        href="/servicios/paginas-web"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border-2 border-white/20 text-white font-bold text-base bg-white/5 hover:bg-white/10 hover:border-white/40 hover:-translate-y-0.5 transition-all"
      >
        Páginas Web
      </a>
    </div>
  </div>
</section>
