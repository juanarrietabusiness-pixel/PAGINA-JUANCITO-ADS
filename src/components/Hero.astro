---
import ParticleCanvas from "./ParticleCanvas.astro";
import { Megaphone, Users, Globe, ArrowRight } from "lucide-astro";
import { metricas, waLink, planesMetaAds, planesRedes, planesWebNuevos, precioDesde } from "../data/site";

/**
 * El hero pregunta antes de proponer, y lo hace desde la izquierda.
 *
 * ── La composición ─────────────────────────────────────────────────
 * Todo el bloque —titular, subtítulo, métrica, pregunta y opciones— va
 * alineado a la izquierda, no centrado. Un texto centrado obliga al ojo a
 * buscar el principio de cada línea; alineado a la izquierda hay un solo punto
 * de entrada y se baja en vertical. En un hero con cinco elementos apilados,
 * eso es la diferencia entre leerlo y ojearlo.
 *
 * ── El selector ────────────────────────────────────────────────────
 *  - **Una pregunta, no una lista.** "¿Qué estás buscando?" convierte el hero
 *    en algo que se responde. Elegir es un micro-compromiso: quien marca una
 *    opción ya entró en el recorrido y sigue por consistencia.
 *  - **Tres opciones y ni una más (ley de Hick).** Decidir cuesta más cuanto
 *    más hay donde elegir. Tres es el techo: **si entra un cuarto servicio no
 *    se añade una cuarta pastilla** —el Bot multicanal, por ejemplo, vive en
 *    `/servicios`— se agrupan dos o se manda a la página de servicios.
 *  - **Tres palabras por opción.** Una etiqueta ("Clientes"), el servicio en
 *    pequeño y el precio. La versión anterior gastaba doce palabras por
 *    tarjeta y había que leerlas para elegir; esto se decide de un vistazo.
 *  - **El precio, antes del clic.** Sale de `precioDesde()` sobre los propios
 *    arrays de planes, así que no puede quedarse viejo.
 *
 * En fila horizontal en escritorio y apiladas en el teléfono, pero apiladas
 * **compactas** (icono a la izquierda, texto al lado): así las tres entran en
 * pantalla sin desplazar, que es de donde llega la mayoría del tráfico.
 */
const opciones = [
  {
    icono: Megaphone,
    etiqueta: "Clientes",
    servicio: "Campañas de anuncios",
    desde: `desde ${precioDesde(planesMetaAds)}/mes`,
    href: "/servicios/campanas-ads",
    acento: "azul",
  },
  {
    icono: Users,
    etiqueta: "Redes",
    servicio: "Campañas + gestión",
    desde: `desde ${precioDesde(planesRedes)}/mes`,
    href: "/servicios/campanas-redes",
    acento: "naranja",
  },
  {
    icono: Globe,
    etiqueta: "Web",
    servicio: "Páginas a medida",
    desde: `desde ${planesWebNuevos[0]!.precio}`,
    href: "/servicios/paginas-web",
    acento: "verde",
  },
];

const acentos = {
  azul: { icono: "bg-blue-neon/10 text-blue-neon border-blue-neon/30", borde: "hover:border-blue-neon/70", precio: "text-blue-neon" },
  naranja: { icono: "bg-orange/10 text-orange border-orange/30", borde: "hover:border-orange/70", precio: "text-orange" },
  verde: { icono: "bg-emerald-400/10 text-emerald-300 border-emerald-400/30", borde: "hover:border-emerald-400/70", precio: "text-emerald-300" },
} as const;
---

<section id="hero" class="relative min-h-svh flex items-center overflow-hidden bg-bg-deep pt-[100px] pb-16 sm:pb-24" aria-label="Bienvenida">
  <ParticleCanvas />

  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[520px] h-[520px] bg-blue-neon/[0.18] -top-[120px] -left-20"
    style="animation: orb-float-1 12s ease-in-out infinite;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[380px] h-[380px] bg-orange/[0.08] -bottom-[60px] right-[5%]"
    style="animation: orb-float-2 15s ease-in-out infinite 2s;"
    aria-hidden="true"
  ></div>

  {/*
    Los tamaños del móvil están medidos, no elegidos a ojo: a 390×844 —el
    teléfono más común— el bloque entero tiene que caber sin desplazar, porque
    la tercera opción cortada por el borde es exactamente lo que hace que nadie
    la elija. Con el titular a 2,6rem y `py-12` se pasaba unos 15px. Si se
    vuelve a tocar el copy del hero, comprobar que las tres pastillas siguen
    entrando enteras.
  */}
  <div class="relative z-[2] w-full max-w-[1160px] mx-auto px-5 sm:px-10 py-8 sm:py-16">
    <h1 class="reveal text-[2.2rem] leading-[1.04] sm:text-6xl md:text-7xl font-black max-w-[15ch] text-balance mb-3">
      Tu negocio puede vender más.
    </h1>
    <p
      class="reveal reveal-delay-1 text-xl sm:text-3xl md:text-4xl font-extrabold text-blue-neon leading-snug mb-4 sm:mb-5"
      style="text-shadow: 0 0 24px rgba(30,144,255,0.5);"
    >
      Lo hacemos con Meta Ads e IA.
    </p>

    <p class="reveal reveal-delay-2 text-sm sm:text-base text-text-sec max-w-[44ch] mb-6 sm:mb-9">
      <strong class="text-white font-extrabold">{metricas.inversionGestionada}</strong>
      {" "}{metricas.inversionGestionadaDetalle}.
    </p>

    <div class="reveal reveal-delay-3">
      <h2 id="selector-titulo" class="text-base sm:text-lg font-extrabold text-white mb-3.5">
        ¿Qué estás buscando?
      </h2>

      <div
        class="grid gap-2.5 sm:gap-3.5 grid-cols-1 sm:grid-cols-3 max-w-[760px]"
        role="group"
        aria-labelledby="selector-titulo"
      >
        {opciones.map((o) => {
          const Icono = o.icono;
          const a = acentos[o.acento as keyof typeof acentos];
          return (
            <a
              href={o.href}
              class={`group flex sm:flex-col items-center sm:items-start gap-3.5 sm:gap-0 rounded-2xl border border-white/12 bg-white/[0.06] p-3.5 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:-translate-y-1 ${a.borde}`}
            >
              <span class={`inline-flex shrink-0 items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-xl border sm:mb-3.5 ${a.icono}`}>
                <Icono class="w-5 h-5" />
              </span>
              <span class="flex-1 min-w-0">
                <span class="block text-lg font-extrabold text-white leading-tight">{o.etiqueta}</span>
                <span class="block text-2xs font-semibold text-text-sec/90 mt-0.5">{o.servicio}</span>
                <span class={`block text-sm font-extrabold mt-1 sm:mt-2.5 ${a.precio}`}>{o.desde}</span>
              </span>
              <ArrowRight class="w-4 h-4 shrink-0 text-white/40 group-hover:text-white group-hover:translate-x-1 transition-all sm:hidden" />
            </a>
          );
        })}
      </div>
    </div>

    <!-- Salida para quien no sepa cuál de los tres necesita. Va debajo y en
         menor peso: es la respuesta a "no sé", no una cuarta opción. -->
    <div class="reveal reveal-delay-4 mt-5 sm:mt-7 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-sm">
      <span class="text-text-sec">¿No sabes cuál?</span>
      <a href="/cotizador" class="font-bold text-white underline underline-offset-4 decoration-white/30 hover:decoration-white transition-colors">
        Arma tu cotización en 1 minuto
      </a>
      <span class="text-white/20" aria-hidden="true">·</span>
      <a
        class="font-bold text-white/90 hover:text-white transition-colors"
        href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
        target="_blank"
        rel="noopener"
      >
        Hablar por WhatsApp
      </a>
    </div>
  </div>
</section>
