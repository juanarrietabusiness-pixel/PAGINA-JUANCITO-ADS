---
import ParticleCanvas from "./ParticleCanvas.astro";
import { metricas, waLink } from "../data/site";

/**
 * El hero remata en dos acciones y no en tres tarjetas de servicio.
 *
 * Las tarjetas repartían la atención entre tres destinos que ya están en el
 * navbar, en /servicios y en el footer. Las dos acciones que de verdad mueven
 * el negocio —cotizar solo, o hablar con alguien— ahora no compiten con nada:
 * quien quiere el precio lo saca sin escribir a nadie, y quien prefiere hablar
 * tiene WhatsApp al lado. Los tres servicios siguen a un clic, abajo.
 */
const servicios = [
  { label: "Campañas de Ads", href: "/servicios/campanas-ads" },
  { label: "Campañas + Redes", href: "/servicios/campanas-redes" },
  { label: "Páginas Web", href: "/servicios/paginas-web" },
];
---

<section id="hero" class="relative min-h-svh flex items-center overflow-hidden bg-bg-deep pt-[100px] pb-16 sm:pb-24" aria-label="Bienvenida">
  <ParticleCanvas />

  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[520px] h-[520px] bg-blue-neon/[0.18] -top-[120px] -left-20"
    style="animation: orb-float-1 12s ease-in-out infinite;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[380px] h-[380px] bg-orange/[0.08] -bottom-[60px] right-[5%]"
    style="animation: orb-float-2 15s ease-in-out infinite 2s;"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] w-full max-w-[1160px] mx-auto px-5 sm:px-10 py-16 sm:py-24 text-center">
    <h1 class="reveal text-4xl sm:text-5xl md:text-7xl font-black leading-tight max-w-[20ch] text-balance mb-4 mx-auto">
      Tu negocio puede vender más.
    </h1>
    <p class="reveal reveal-delay-1 text-2xl sm:text-3xl md:text-4xl font-extrabold text-blue-neon leading-snug mb-8 mx-auto" style="text-shadow: 0 0 24px rgba(30,144,255,0.5);">
      Lo hacemos con Meta Ads e IA.
    </p>

    <p class="reveal reveal-delay-2 text-sm sm:text-base text-text-sec mb-12 mx-auto max-w-[46ch]">
      <strong class="text-white font-extrabold">{metricas.inversionGestionada}</strong>
      {" "}{metricas.inversionGestionadaDetalle}.
    </p>

    <div class="reveal reveal-delay-3 flex flex-wrap items-center justify-center gap-4">
      <a class="btn btn-primary" href="/cotizador">
        <span class="dot" aria-hidden="true"></span> Cotizar mi campaña
      </a>
      <a
        class="btn btn-ghost"
        href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
        target="_blank"
        rel="noopener"
      >
        Hablar por WhatsApp
      </a>
    </div>

    <nav class="reveal reveal-delay-4 mt-12 flex flex-wrap items-center justify-center gap-x-2 gap-y-1" aria-label="Servicios">
      {servicios.map((s, i) => (
        <>
          {i > 0 && <span class="text-white/20" aria-hidden="true">·</span>}
          <a
            href={s.href}
            class="px-3 py-2.5 text-sm font-semibold text-text-sec hover:text-white transition-colors"
          >
            {s.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</section>
