---
import ParticleCanvas from "./ParticleCanvas.astro";
import { Megaphone, Users, Globe, ArrowRight } from "lucide-astro";
import { metricas, waLink, planesMetaAds, planesRedes, planesWebNuevos, precioDesde } from "../data/site";

/**
 * El hero pregunta antes de proponer.
 *
 * ── Por qué un selector y no dos botones ───────────────────────────
 * Antes el hero remataba en "Cotizar mi campaña" + WhatsApp, y los tres
 * servicios quedaban en una fila de enlaces sueltos debajo. El problema es que
 * los tres servicios son negocios distintos —publicidad, redes y web— y quien
 * llega ya sabe cuál de los tres quiere; obligarle a pasar por un cotizador
 * genérico o a leer una fila de enlaces grises es ponerle un paso de más justo
 * donde más atención hay.
 *
 * ── Qué se aplicó, y por qué ───────────────────────────────────────
 *  - **Una pregunta directa, no una lista.** "¿Qué estás buscando?" convierte
 *    el hero en algo que se responde. Elegir es un micro-compromiso: quien
 *    marca una opción ya entró en el recorrido, y sigue por consistencia.
 *  - **Tres opciones y ni una más (ley de Hick).** El tiempo que cuesta decidir
 *    crece con el número de alternativas. Tres es lo que hay que ofrecer y es
 *    el techo: **si algún día entra un cuarto servicio, no se añade una cuarta
 *    tarjeta aquí** — se agrupan dos o se manda a `/servicios`.
 *  - **Etiquetas en las palabras del cliente, no en las de la agencia.** La
 *    línea grande de cada tarjeta es lo que la persona quiere que pase ("Quiero
 *    que me lleguen clientes"), y el nombre del servicio va debajo, en pequeño.
 *    Quien no sabe qué es "Meta Ads" igual se reconoce en la primera línea; el
 *    nombre técnico está para quien sí lo busca.
 *  - **El precio, antes del clic.** Cada tarjeta enseña desde cuánto arranca.
 *    Esconderlo no evita la pregunta, solo la retrasa hasta WhatsApp — y el
 *    precio sale de los propios arrays de planes vía `precioDesde()`, así que
 *    no puede quedarse viejo.
 *
 * Quien todavía no sepa cuál de los tres necesita tiene la salida de abajo: el
 * cotizador, que es precisamente la herramienta para decidir.
 */
const opciones = [
  {
    icono: Megaphone,
    quiero: "Quiero que me lleguen clientes",
    servicio: "Campañas de anuncios en Meta",
    detalle: "Publicidad en Instagram y Facebook, creada y optimizada con IA.",
    desde: `desde ${precioDesde(planesMetaAds)}/mes`,
    href: "/servicios/campanas-ads",
    acento: "azul",
  },
  {
    icono: Users,
    quiero: "Quiero que mis redes trabajen solas",
    servicio: "Campañas + gestión de redes",
    detalle: "Contenido diario, reels y campañas activas. Todo manejado por nosotros.",
    desde: `desde ${precioDesde(planesRedes)}/mes`,
    href: "/servicios/campanas-redes",
    acento: "naranja",
  },
  {
    icono: Globe,
    quiero: "Quiero una página web que venda",
    servicio: "Páginas web a medida",
    detalle: "Rápidas, listas para recibir anuncios y con el código a tu nombre.",
    desde: `desde ${planesWebNuevos[0]!.precio}`,
    href: "/servicios/paginas-web",
    acento: "verde",
  },
];

const acentos = {
  azul: {
    icono: "bg-blue-neon/10 text-blue-neon border-blue-neon/30",
    borde: "hover:border-blue-neon/70",
    precio: "text-blue-neon",
  },
  naranja: {
    icono: "bg-orange/10 text-orange border-orange/30",
    borde: "hover:border-orange/70",
    precio: "text-orange",
  },
  verde: {
    icono: "bg-emerald-400/10 text-emerald-300 border-emerald-400/30",
    borde: "hover:border-emerald-400/70",
    precio: "text-emerald-300",
  },
} as const;
---

<section id="hero" class="relative min-h-svh flex items-center overflow-hidden bg-bg-deep pt-[100px] pb-16 sm:pb-24" aria-label="Bienvenida">
  <ParticleCanvas />

  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[520px] h-[520px] bg-blue-neon/[0.18] -top-[120px] -left-20"
    style="animation: orb-float-1 12s ease-in-out infinite;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute rounded-full pointer-events-none blur-[90px] w-[380px] h-[380px] bg-orange/[0.08] -bottom-[60px] right-[5%]"
    style="animation: orb-float-2 15s ease-in-out infinite 2s;"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] w-full max-w-[1160px] mx-auto px-5 sm:px-10 py-12 sm:py-20 text-center">
    <h1 class="reveal text-4xl sm:text-5xl md:text-7xl font-black leading-tight max-w-[20ch] text-balance mb-4 mx-auto">
      Tu negocio puede vender más.
    </h1>
    <p class="reveal reveal-delay-1 text-2xl sm:text-3xl md:text-4xl font-extrabold text-blue-neon leading-snug mb-6 mx-auto" style="text-shadow: 0 0 24px rgba(30,144,255,0.5);">
      Lo hacemos con Meta Ads e IA.
    </p>

    <p class="reveal reveal-delay-2 text-sm sm:text-base text-text-sec mb-10 mx-auto max-w-[46ch]">
      <strong class="text-white font-extrabold">{metricas.inversionGestionada}</strong>
      {" "}{metricas.inversionGestionadaDetalle}.
    </p>

    <!-- El selector: la pregunta es el título de esta zona, así que va en un
         <h2> y el grupo de tarjetas cuelga de él por aria-labelledby. -->
    <div class="reveal reveal-delay-3">
      <h2 id="selector-titulo" class="text-lg sm:text-xl font-extrabold text-white mb-1.5">
        ¿Qué estás buscando?
      </h2>
      <p class="text-sm text-text-sec mb-7">Elige lo que necesita tu negocio y te llevamos directo a los planes.</p>

      <div class="grid gap-3.5 sm:gap-4 grid-cols-1 md:grid-cols-3 text-left" role="group" aria-labelledby="selector-titulo">
        {opciones.map((o) => {
          const Icono = o.icono;
          const a = acentos[o.acento as keyof typeof acentos];
          return (
            <a
              href={o.href}
              class={`group relative flex md:flex-col items-center md:items-start gap-4 md:gap-0 rounded-2xl border border-white/12 bg-white/[0.06] p-4 sm:p-5 md:p-6 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:-translate-y-1 ${a.borde}`}
            >
              <span class={`inline-flex shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl border md:mb-5 ${a.icono}`}>
                <Icono class="w-5 h-5 md:w-6 md:h-6" />
              </span>

              <span class="flex-1 min-w-0">
                <span class="block text-base sm:text-lg font-extrabold text-white leading-snug text-balance">
                  {o.quiero}
                </span>
                <span class="block text-xs font-semibold text-text-sec/90 mt-1">{o.servicio}</span>
                <span class="hidden md:block text-sm text-text-sec leading-relaxed mt-3">{o.detalle}</span>

                <span class="flex items-center justify-between gap-2 mt-2 md:mt-5">
                  <span class={`text-sm font-extrabold ${a.precio}`}>{o.desde}</span>
                  <ArrowRight class="w-4 h-4 text-white/50 group-hover:text-white group-hover:translate-x-1 transition-all" />
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Salida para quien no sepa cuál de los tres necesita. Va debajo y en
         menor peso: es la respuesta a "no sé", no una cuarta opción. -->
    <div class="reveal reveal-delay-4 mt-9 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-sm">
      <span class="text-text-sec">¿No sabes cuál?</span>
      <a href="/cotizador" class="font-bold text-white underline underline-offset-4 decoration-white/30 hover:decoration-white transition-colors">
        Arma tu cotización en 1 minuto
      </a>
      <span class="text-white/20" aria-hidden="true">·</span>
      <a
        class="font-bold text-white/90 hover:text-white transition-colors"
        href={waLink("Hola Juancito Ads, quiero hacer crecer mi negocio. ¿Podemos hablar?")}
        target="_blank"
        rel="noopener"
      >
        Hablar por WhatsApp
      </a>
    </div>
  </div>
</section>
