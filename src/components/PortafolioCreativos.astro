---
import { Play } from "lucide-astro";
import VideoModal from "./VideoModal.astro";
import { portafolioVideos } from "../data/site";

/**
 * Categoría 03 — video y reels de campañas reales.
 *
 * ── Qué cambió y por qué ───────────────────────────────────────────
 * Antes esta sección tenía dos bloques: un mosaico de tres gráficas y una
 * parrilla de videos. Las gráficas salieron de aquí —siguen en el sitio, pero
 * como pieza grande junto al texto que explica el trabajo, en la portada y en
 * las dos páginas de campañas, que es donde una imagen convence— y los videos
 * se rehicieron.
 *
 * El problema de la parrilla anterior era de encuadre, no de estilo: las cuatro
 * tarjetas eran cajas 16:9 idénticas con `object-cover`, y uno de los cuatro
 * videos es un reel vertical (1080×1920). De ese se veía la franja del medio,
 * recortada arriba y abajo. Cuatro rectángulos iguales y un recorte: de ahí que
 * se leyera como "cuadrado y sin diseño".
 *
 * Ahora la retícula es asimétrica y sigue al material: el vertical ocupa una
 * columna alta a la izquierda —a su proporción real, 9:16— y los horizontales
 * se apilan a la derecha. Si algún día hay más de un vertical, el primero manda
 * en la columna alta y el resto entra en la pila; la retícula no se rompe, pero
 * conviene revisar cómo queda.
 *
 * ── El fotograma de portada, y por qué la tarjeta no depende de él ──
 * Los videos siguen sin `poster` propio, así que dependen de que el navegador
 * pinte un fotograma por su cuenta. El fragmento `#t=0.1` del `src` pide
 * explícitamente ese instante, que es lo que empuja a la mayoría de navegadores
 * a dibujar algo en vez de dejar la caja en negro. **La URL del modal va
 * aparte, sin el fragmento**, para que al reproducir arranque desde el
 * principio.
 *
 * Aun así la tarjeta está construida para sostenerse sin fotograma: lleva su
 * propio degradado de fondo, su etiqueta de formato y el botón de play
 * enmarcado. Si el navegador no llega a pintar nada, se ve una tarjeta oscura
 * con rótulo y play —algo intencionado—, no un hueco roto.
 *
 * **Pendiente, y es el arreglo de verdad:** generar un `poster` real por video
 * (un JPG/WebP del fotograma) y servirlo con `poster="..."`. No se pudo hacer
 * en la sesión en que se escribió esto: el ffmpeg del entorno venía compilado
 * con `--disable-everything` (sin demuxer mov ni H.264) y el Chromium headless
 * de Playwright no trae códecs propietarios, así que ninguna de las dos vías
 * podía abrir los archivos. Los `.mp4` son en realidad QuickTime
 * (`ftyp qt`) de 56–71 MB cada uno; al comprimirlos —punto 6 del roadmap—
 * conviene sacar el poster en el mismo paso.
 */
const vertical = portafolioVideos.find((v) => v.orientacion === "vertical");
const horizontales = portafolioVideos.filter((v) => v !== vertical);
---

<section id="creativos" class="relative overflow-hidden bg-bg-alt py-24 sm:py-32 scroll-mt-24">
  <div class="relative z-[1] w-full max-w-[1160px] mx-auto px-5 sm:px-10">
    <header class="max-w-[62ch] mb-12 sm:mb-16">
      <span class="reveal inline-block text-2xs font-bold tracking-[0.18em] uppercase text-blue-neon mb-3">
        Categoría 03 — Creativos de campaña
      </span>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-4xl font-black mb-4">Piezas que salieron a pautar</h2>
      <p class="reveal reveal-delay-2 text-text-sec text-balance">
        Reels y video producidos para campañas de Meta Ads de clientes en Panamá.
        Toca cualquiera para reproducirlo.
      </p>
    </header>

    <div class="grid gap-4 sm:gap-5 grid-cols-1 lg:grid-cols-12 items-start">
      {vertical && (
        <div class="reveal lg:col-span-4">
          <button
            type="button"
            class="port-vid-card group relative block w-full rounded-2xl overflow-hidden border border-white/10 bg-bg-deep hover:border-blue-neon/60 hover:-translate-y-1.5 hover:shadow-glow-blue transition-all duration-300"
            style="transition-timing-function: var(--ease-brand);"
            data-src={vertical.src}
            aria-label={`Reproducir ${vertical.formato.toLowerCase()} vertical de campaña`}
          >
            <div class="relative w-full aspect-[9/16] overflow-hidden" style="background: linear-gradient(155deg, rgba(30,144,255,0.16) 0%, rgba(5,13,31,1) 55%, rgba(245,166,35,0.10) 100%);">
              <video
                src={`${vertical.src}#t=0.1`}
                preload="metadata"
                muted
                playsinline
                class="w-full h-full object-cover block pointer-events-none group-hover:scale-105 transition-transform duration-700"
              ></video>
              <span class="absolute inset-0 bg-gradient-to-t from-bg-deep/85 via-bg-deep/10 to-bg-deep/30" aria-hidden="true"></span>

              <span class="absolute top-4 left-4 inline-flex items-center rounded-full border border-white/20 bg-bg-deep/70 px-3 py-1 text-2xs font-bold uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                {vertical.formato} · Vertical
              </span>

              <span class="absolute inset-0 flex items-center justify-center">
                <span class="inline-flex items-center justify-center w-16 h-16 rounded-full border border-white/25 bg-bg-deep/55 backdrop-blur-sm group-hover:bg-blue-neon group-hover:border-blue-neon group-hover:scale-110 transition-all duration-300">
                  <Play class="w-6 h-6 text-white fill-white translate-x-[2px]" aria-hidden="true" />
                </span>
              </span>

              <span class="absolute bottom-4 left-4 right-4 text-left">
                <span class="block text-sm font-extrabold text-white">Formato para Reels e Historias</span>
                <span class="block text-2xs text-text-sec mt-0.5">9:16, el encuadre que ocupa toda la pantalla del celular</span>
              </span>
            </div>
          </button>
        </div>
      )}

      {/* El último horizontal ocupa las dos columnas: con tres piezas, una
          parrilla 2×2 dejaba un hueco vacío abajo a la derecha del tamaño de
          una tarjeta entera, y ese vacío se leía como algo que faltaba. */}
      <div class="lg:col-span-8 grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2">
        {horizontales.map((v, i) => (
          <button
            type="button"
            class={`reveal reveal-delay-${(i % 3) + 1} port-vid-card group relative block w-full rounded-2xl overflow-hidden border border-white/10 bg-bg-deep hover:border-blue-neon/60 hover:-translate-y-1.5 hover:shadow-glow-blue transition-all duration-300 ${i === horizontales.length - 1 && horizontales.length % 2 === 1 ? "sm:col-span-2" : ""}`}
            style="transition-timing-function: var(--ease-brand);"
            data-src={v.src}
            aria-label={`Reproducir video de campaña ${i + 1}`}
          >
            <div class="relative w-full aspect-video overflow-hidden" style="background: linear-gradient(155deg, rgba(30,144,255,0.14) 0%, rgba(5,13,31,1) 60%, rgba(245,166,35,0.08) 100%);">
              <video
                src={`${v.src}#t=0.1`}
                preload="metadata"
                muted
                playsinline
                class="w-full h-full object-cover block pointer-events-none group-hover:scale-105 transition-transform duration-700"
              ></video>
              <span class="absolute inset-0 bg-gradient-to-t from-bg-deep/80 via-transparent to-bg-deep/25" aria-hidden="true"></span>

              <span class="absolute top-3 left-3 inline-flex items-center rounded-full border border-white/20 bg-bg-deep/70 px-2.5 py-1 text-2xs font-bold uppercase tracking-[0.14em] text-white backdrop-blur-sm">
                {v.formato} {String(i + 1).padStart(2, "0")}
              </span>

              <span class="absolute inset-0 flex items-center justify-center">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-white/25 bg-bg-deep/55 backdrop-blur-sm group-hover:bg-blue-neon group-hover:border-blue-neon group-hover:scale-110 transition-all duration-300">
                  <Play class="w-4.5 h-4.5 text-white fill-white translate-x-[1px]" aria-hidden="true" />
                </span>
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<VideoModal />

<script>
  function initPortfolioVideos() {
    const modal = document.getElementById("portVidModal");
    const modalVid = document.getElementById("portModalVideo") as HTMLVideoElement | null;
    const btnClose = document.getElementById("portVidClose");
    const backdrop = document.getElementById("portVidBackdrop");
    if (!modal || !modalVid) return;

    function open(src: string) {
      modalVid!.src = src;
      modal!.classList.remove("hidden");
      modal!.classList.add("flex");
      document.body.style.overflow = "hidden";
      modalVid!.play().catch(() => {});
    }

    function close() {
      modalVid!.pause();
      modalVid!.src = "";
      modal!.classList.add("hidden");
      modal!.classList.remove("flex");
      document.body.style.overflow = "";
    }

    document.querySelectorAll(".port-vid-card").forEach((card) => {
      card.addEventListener("click", () => {
        // `data-src` va sin el fragmento `#t=0.1` de la miniatura: el modal
        // tiene que arrancar en el segundo cero, no en el fotograma de portada.
        const src = card.getAttribute("data-src");
        if (src) open(src);
      });
    });

    btnClose?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (!modal!.classList.contains("hidden") && e.key === "Escape") close();
    });
  }

  initPortfolioVideos();
</script>
