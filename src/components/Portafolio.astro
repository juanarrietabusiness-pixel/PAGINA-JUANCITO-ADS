---
import PortafolioWebs from "./PortafolioWebs.astro";
import FondoEscena from "./FondoEscena.astro";
import PortafolioCasos from "./PortafolioCasos.astro";
import PortafolioCreativos from "./PortafolioCreativos.astro";
import { metricas, sitiosWeb } from "../data/site";

/**
 * Portada del portafolio y orquestación de sus tres categorías.
 *
 * El portafolio estaba desordenado porque mezclaba tres cosas que se juzgan de
 * forma distinta —sitios web, resultados de campaña y piezas creativas— en una
 * sucesión de bloques sin jerarquía. Ahora cada una es una categoría con su
 * propia sección, su rótulo numerado y su ancla, y esta portada existe para
 * decir en diez segundos qué hay dentro y dejar saltar a lo que interese.
 *
 * Las cifras salen de datos, no de literales: `inversionGestionada` de
 * `site.ts` y el número de sitios se cuenta de `sitiosWeb`. Añadir un proyecto
 * al portafolio actualiza la cifra sola.
 */
const categorias = [
  { href: "#webs", label: "Sitios web", detalle: `${sitiosWeb.length} proyectos` },
  { href: "#casos", label: "Resultados", detalle: "Casos en Panamá" },
  { href: "#creativos", label: "Creativos", detalle: "Reels y video" },
];

const cifras = [
  {
    valor: metricas.inversionGestionada,
    titulo: "En Meta Ads gestionados",
    detalle: "Inversión publicitaria real optimizada",
  },
  {
    valor: `${sitiosWeb.length} sitios`,
    titulo: "En producción hoy",
    detalle: "Con enlace público que puedes abrir",
  },
  {
    valor: "2 semanas",
    titulo: "Para ver las primeras señales",
    detalle: "Medido en campañas de clientes reales",
  },
];
---

<section class="relative overflow-hidden bg-bg-deep pt-28 sm:pt-36 pb-16 sm:pb-20">
    <FondoEscena src="red-esferas" intensidad={0.24} foco="72% center" />

  <div class="relative z-[1] w-full max-w-[1160px] mx-auto px-5 sm:px-10">
    <div class="max-w-[68ch]">
      <span class="reveal inline-block text-2xs font-bold tracking-[0.18em] uppercase text-blue-neon mb-4">
        Portafolio
      </span>
      <h1 class="reveal reveal-delay-1 text-4xl sm:text-5xl md:text-6xl font-black leading-[1.05] mb-5 text-balance">
        Trabajo hecho, con la dirección puesta.
      </h1>
      <p class="reveal reveal-delay-2 text-base sm:text-lg text-text-sec text-balance">
        Todo lo que hay en esta página está publicado y es de clientes reales. Los sitios web se
        pueden abrir, los resultados vienen de campañas que corrieron de verdad y las piezas
        creativas salieron a pautar.
      </p>
    </div>

    <!-- Índice de categorías: dice qué hay dentro y deja saltar directo. -->
    <nav class="reveal reveal-delay-3 mt-10 flex flex-wrap gap-3" aria-label="Categorías del portafolio">
      {categorias.map((c) => (
        <a
          href={c.href}
          class="group flex items-baseline gap-2 rounded-full border border-white/12 bg-white/[0.04] px-5 py-3 hover:border-blue-neon/60 hover:bg-white/[0.07] transition-all"
        >
          <span class="text-sm font-bold text-white">{c.label}</span>
          <span class="text-2xs text-text-sec group-hover:text-blue-neon transition-colors">{c.detalle}</span>
        </a>
      ))}
    </nav>

    <dl class="reveal reveal-delay-4 mt-12 sm:mt-14 grid grid-cols-1 sm:grid-cols-3 gap-px rounded-2xl border border-white/10 bg-white/10 overflow-hidden">
      {cifras.map((c) => (
        <div class="flex flex-col justify-center bg-bg-deep p-7 sm:p-8">
          <dt class="sr-only">{c.titulo}</dt>
          <dd>
            <span class="block text-2xl sm:text-3xl font-black text-orange mb-2">{c.valor}</span>
            <span class="block text-sm font-semibold text-white mb-1">{c.titulo}</span>
            <span class="block text-2xs text-text-sec">{c.detalle}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<PortafolioWebs />
<PortafolioCasos />
<PortafolioCreativos />
