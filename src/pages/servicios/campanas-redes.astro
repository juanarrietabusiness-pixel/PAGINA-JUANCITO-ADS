---
import Layout from "../../layouts/Layout.astro";
import PlanCard from "../../components/PlanCard.astro";
import Metodologia from "../../components/Metodologia.astro";
import SeccionMedia from "../../components/SeccionMedia.astro";
import CTAFinal from "../../components/CTAFinal.astro";
import { planesRedes } from "../../data/site";
import { servicio, migasDePan } from "../../data/schema";
import { ChevronRight, CheckCircle2 } from "lucide-astro";

const descripcion =
  "Manejamos tu marketing por completo. Publicaciones diarias de alta calidad, reels y campañas en Meta Ads para captar clientes en Panamá.";

const schema = [
  servicio(
    {
      nombre: "Campañas + gestión de redes sociales",
      descripcion,
      serviceType: "Gestión de redes sociales y publicidad",
      ruta: "/servicios/campanas-redes",
      planes: planesRedes,
      recurrencia: "mensual",
    },
    Astro.site!
  ),
  migasDePan(
    [
      { nombre: "Inicio", ruta: "/" },
      { nombre: "Servicios", ruta: "/servicios" },
      { nombre: "Campañas + Redes", ruta: "/servicios/campanas-redes" },
    ],
    Astro.site!
  ),
];
---

<Layout
  title="Campañas + Redes Sociales — Juancito Ads"
  description={descripcion}
  schema={schema}
>
  <section class="atmosphere relative overflow-hidden bg-bg-deep pt-28 sm:pt-40 pb-20">
    <div class="relative z-[1] w-full max-w-[1160px] mx-auto px-5 sm:px-10">

      <!-- Breadcrumb -->
      <nav class="reveal flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-text-sec/60 mb-10" aria-label="Breadcrumb">
        <a href="/servicios" class="hover:text-white transition-colors">Servicios</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-orange">Campañas + Redes</span>
      </nav>

      <div class="text-center mb-16 sm:mb-20">
        <span class="reveal inline-block text-xs font-bold tracking-widest uppercase text-orange mb-3">Servicio Todo en Uno</span>
        <h1 class="reveal reveal-delay-1 text-4xl sm:text-5xl font-black mb-4">Campañas + Redes Sociales</h1>
        <p class="reveal reveal-delay-2 text-text-sec max-w-[56ch] mx-auto text-balance mb-4">
          Para negocios que quieren un crecimiento continuo y profesional. Creación de contenido diario con IA, reels e influencers integrados con campañas publicitarias en Meta.
        </p>
        <p class="reveal reveal-delay-3 text-xs text-text-sec/70 italic">
          * El presupuesto de anuncios va siempre aparte. Tú tienes el control total.
        </p>
      </div>

      <div class="grid gap-6 items-start grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        {planesRedes.map((plan, i) => <PlanCard plan={plan} delay={i + 1} />)}
      </div>

    </div>
  </section>

  <SeccionMedia
    eyebrow="Contenido real, todos los días"
    titulo="El mismo producto, contado como se merece."
    imagen="/portafolio/creativos/panales-01.webp"
    alt="Pieza real de Juancito Ads para una marca de pañales hipoalergénicos: la foto original del producto en el almacén y la versión final ambientada, con precios por caja y tallas"
    lado="izquierda"
    foco="75% center"
    intensidad={0.46}
    acento="naranja"
  >
    <p class="mb-5">
      Un plan de redes no es publicar por publicar. Cada pieza sale del calendario del
      mes, se aprueba antes de salir y va con la información que tu cliente pregunta
      igual todos los días: qué tallas hay, cuánto cuesta y cómo se pide.
    </p>
    <ul class="flex flex-col gap-3">
      {[
        "Calendario del mes aprobado por ti antes de publicar nada",
        "Post, reels y carruseles — de 1 a 4 diarios según el plan",
        "Jornadas de grabación presencial para el contenido que la IA no puede hacer",
      ].map((linea) => (
        <li class="flex items-start gap-2.5 text-sm">
          <CheckCircle2 class="w-4 h-4 shrink-0 mt-0.5 text-orange" />
          <span>{linea}</span>
        </li>
      ))}
    </ul>
  </SeccionMedia>

  <!-- Fórmula con IA -->
  <Metodologia />

  <CTAFinal />
</Layout>
